# Copy to .env; never commit real secrets.
SECRET_KEY=replace-with-a-random-local-secret
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:@localhost/smart_ticket_db
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# true only when serving over HTTPS
COOKIE_SECURE=false

# bm25 (default) or baseline for comparison
AI_RETRIEVAL_METHOD=bm25
